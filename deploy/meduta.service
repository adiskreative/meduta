[Unit]
Description=Meduta — Next.js wedding invitation app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meduta
Group=meduta
WorkingDirectory=/opt/meduta
EnvironmentFile=/opt/meduta/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Build butuh DATABASE_URL/DIRECT_URL saat prisma generate — dibaca dari .env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening ringan
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
