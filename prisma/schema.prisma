// Meduta — Database schema
// Prisma 7 format: datasource URL dikelola lewat prisma7.config.ts (bukan di schema)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-workerd"
  runtime  = "workerd"
}

generator clientNode {
  provider = "prisma-client"
  output   = "../generated/prisma-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AssetType {
  IMAGE
  FRAME
  DECOR
  BACKGROUND
  MUSIC
  GALLERY
}

enum NotificationType {
  RSVP
  WISH
  TRANSACTION
  SYSTEM
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  emailVerified            DateTime?
  emailConfirmationPending Boolean         @default(false)
  password                 String
  name                     String?
  image                    String?
  avatarUrl                String?
  role                     Role            @default(USER)
  createdAt                DateTime        @default(now())
  accounts                 Account[]
  sessions                 Session[]
  invitations              Invitation[]
  transactions             Transaction[]
  assets                   TemplateAsset[]
  createdTemplates         Template[]
  notifications            Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Template {
  id              String               @id @default(cuid())
  name            String
  thumbnailUrl    String
  componentKey    String               @unique // penanda component React yang di-render
  isPremium       Boolean              @default(false)
  defaultMusicUrl String? // musik latar bawaan template (diwarisi undangan)
  sampleData      Json? // data contoh preview/thumbnail (override default); null = bawaan
  createdBy       String?
  creator         User?                @relation(fields: [createdBy], references: [id])
  invitations     Invitation[]
  decorations     TemplateDecoration[]
}

model TemplateAsset {
  id        String    @id @default(cuid())
  adminId   String
  admin     User      @relation(fields: [adminId], references: [id])
  type      AssetType // IMAGE | FRAME | DECOR | BACKGROUND | MUSIC | GALLERY
  name      String
  url       String // URL file/Upload (mis. Supabase Storage)
  thumbnail String?
  meta      Json? // warna, bentuk, dsb opsional
  createdAt DateTime  @default(now())

  decorations TemplateDecoration[]

  @@index([type])
}

model TemplateDecoration {
  id         String        @id @default(cuid())
  templateId String
  template   Template      @relation(fields: [templateId], references: [id])
  assetId    String
  asset      TemplateAsset @relation(fields: [assetId], references: [id])

  placement String @default("floating") // cover | section | floating
  position  Json? // { x, y } atau { top/left } relatif
  size      Json? // { width, height }
  zIndex    Int    @default(1)
  layer     String @default("decor") // decor | frame
  rotated   Float? // rotasi derajat

  @@index([templateId])
  @@index([assetId])
}

model Invitation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  templateId      String
  template        Template @relation(fields: [templateId], references: [id])
  slug            String   @unique
  slugChangeCount Int      @default(0) // max 3x ganti
  status          String   @default("draft") // draft | published
  data            Json // semua field dinamis: mempelai, cerita cinta, acara, dll
  expiresAt       DateTime? // masa aktif undangan (gratis = 1 bulan); null = aktif selamanya
  guests          Guest[]
  wishes          Wish[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([templateId])
}

model Guest {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  name         String
  email        String?
  phone        String? // nomor WhatsApp tamu
  uniqueLink   String     @unique
  rsvpStatus   String? // hadir | tidak_hadir | belum_konfirmasi
  guestCount   Int?
  message      String?
  submittedAt  DateTime?
  emailSent    Boolean    @default(false) // apakah email undangan sudah dikirim
  emailSentAt  DateTime? // kapan email undangan terakhir dikirim
  lastSendError String? // error dari pengiriman email terakhir (jika ada)
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  guestName    String
  message      String
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  gatewayReference String? @map("midtransId")
  packageName String
  amount      Int
  status      String // pending | success | failed
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType @default(SYSTEM)
  title      String
  body       String?
  link       String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}
