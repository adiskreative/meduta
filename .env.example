# ============================================================
# Meduta — Environment variables template
# Copy ke `.env` lalu isi nilai aslinya. JANGAN commit `.env`.
# JANGAN pernah push `.env` ke git — dia sudah ada di .gitignore.
# ============================================================

# ---- Database (Supabase PostgreSQL) ----
# Transaction Pooler (port 6543) untuk runtime — hindari error P1001 IPv6
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session Pooler (port 5432) untuk prisma migrate / db push (DDL)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth (NextAuth.js v5) ----
# Generate dengan: `npx auth secret` atau `openssl rand -base64 32`.
# WAJIB berbeda antara development dan production. Jangan pakai nilai contoh.
AUTH_SECRET="generate-dengan: npx auth secret"
AUTH_TRUST_HOST=true

# ---- Google OAuth (opsional) ----
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Admin user (dipakai saat seed) ----
# Ganti password kuat sebelum dipakai di production. Jangan pakai nilai contoh.
ADMIN_EMAIL="admin@meduta.com"
ADMIN_PASSWORD="GANTI-DENGAN-PASSWORD-KUAT"
ADMIN_NAME="Admin"

# ---- Supabase Storage ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Berikut opsional, dipakai untuk verifikasi JWT Supabase:
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# ---- Email (Resend) ----
# Daftar di https://resend.com, buat API Key di dashboard.
# Nilai kosong = pengiriman email dimatikan (aman untuk development).
RESEND_API_KEY=""
# Alamat pengirim harus domain terverifikasi di Resend, mis.:
EMAIL_FROM="Meduta <undangan@domain-anda.com>"
# Jeda antar email (ms) saat kirim massal/import — hindari rate limit Resend
EMAIL_DELAY_MS=200

# ---- Midtrans (payment) ----
# Server Key: pakai server key production / sandbox sesuai environment
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# ---- App URL ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
