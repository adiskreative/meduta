# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev server stdout/stderr logs
.dev-*.log

# OAuth client secrets (Google, dll) — jangan pernah commit
client_secret_*.json

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# prisma generated client
/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Thumbnail generator scratch
.tmp-thumbs/
.tmp-chrome-profile/
.tmp-edge-profile/
.dev-server.log

# Freebuff agent artifacts
.freebuff/*.log
.freebuff/*.log.err
